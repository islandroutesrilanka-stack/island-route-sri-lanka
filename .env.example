# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Email notifications (Gmail SMTP) ----
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=islandroutesrilanka@gmail.com
SMTP_PASS=your-gmail-app-password
ADMIN_EMAIL=islandroutesrilanka@gmail.com

# ---- Telegram alerts (instant push for new bookings) ----
# Talk to @BotFather on Telegram: /newbot gives you the token.
# Chat ID: message your new bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[0].message.chat.id
# Leave both blank to disable — bookings are still saved and emailed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Site ----
# The origin every canonical, og:url, og:image, sitemap entry and robots.txt
# host is built from. It must be a host that actually serves the site: the www
# subdomain is not pointed at Vercel and 302s to a link-parking page, so a www
# value here silently sends Google and every social scraper off-site. Apex only
# unless and until the www DNS record is repointed. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://islandroutesrilanka.com
