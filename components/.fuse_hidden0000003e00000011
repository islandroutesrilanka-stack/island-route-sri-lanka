"use client";

import { useMemo, useState, useTransition } from "react";
import { motion } from "framer-motion";
import { Send, MessageCircle, Check, Loader2 } from "lucide-react";
import { site, waLink } from "@/lib/site";
import { submitBooking, submitInquiry } from "@/lib/actions";

const serviceOptions = [
  "Airport Transfer",
  "Private Driver Hire",
  "Taxi / Point-to-Point",
  "Day Tour",
  "Multi-Day Tour",
  "Safari Tour",
  "Surf Transfer",
  "Hotel Transfer",
  "Custom Itinerary",
];

const inputCls =
  "w-full border border-ink/15 bg-white/60 px-4 py-3.5 text-[15px] text-ink placeholder:text-ink/35 focus:outline-none focus:border-copper transition-colors";

export default function BookingForm({
  defaultService,
  defaultMessage,
  kind = "booking",
}: {
  defaultService?: string;
  defaultMessage?: string;
  kind?: "booking" | "inquiry";
}) {
  const [form, setForm] = useState({
    name: "",
    email: "",
    phone: "",
    service: defaultService ?? "",
    date: "",
    travellers: "2",
    message: defaultMessage ?? "",
  });
  const [state, setState] = useState<"idle" | "saved" | "wa" | "error">("idle");
  const [pending, startTransition] = useTransition();

  const set = (k: keyof typeof form) => (
    e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>
  ) => setForm((f) => ({ ...f, [k]: e.target.value }));

  const composed = useMemo(() => {
    const lines = [
      kind === "booking"
        ? "Hello Island Route! I'd like to request a quote."
        : "Hello Island Route! I have a question.",
      form.name && `Name: ${form.name}`,
      form.email && `Email: ${form.email}`,
      form.phone && `Phone: ${form.phone}`,
      form.service && `Service: ${form.service}`,
      form.date && `Travel date: ${form.date}`,
      form.travellers && `Travellers: ${form.travellers}`,
      form.message && `Details: ${form.message}`,
    ].filter(Boolean);
    return lines.join("\n");
  }, [form, kind]);

  const submit = (e: React.FormEvent) => {
    e.preventDefault();
    startTransition(async () => {
      const res =
        kind === "booking"
          ? await submitBooking({
              name: form.name,
              email: form.email,
              phone: form.phone,
              service: form.service,
              travelDate: form.date || undefined,
              travellers: form.travellers,
              message: form.message,
            })
          : await submitInquiry({
              name: form.name,
              email: form.email,
              phone: form.phone,
              subject: form.service || "General enquiry",
              message: form.message,
            });

      if (res.ok) {
        setState("saved");
      } else if (res.code === "no_backend") {
        // Backend not connected yet — gracefully fall back to WhatsApp
        window.open(waLink(composed), "_blank", "noopener,noreferrer");
        setState("wa");
      } else {
        setState("error");
      }
    });
  };

  const openWhatsApp = () => {
    window.open(waLink(composed), "_blank", "noopener,noreferrer");
  };

  const mailto = `mailto:${site.email}?subject=${encodeURIComponent(
    `Trip enquiry — ${form.service || "Sri Lanka travel"}`
  )}&body=${encodeURIComponent(composed)}`;

  if (state === "saved") {
    return (
      <motion.div
        initial={{ opacity: 0, y: 14 }}
        animate={{ opacity: 1, y: 0 }}
        className="border border-copper/30 bg-white/60 p-8 md:p-10 text-center"
      >
        <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-copper/10 text-copper">
          <Check size={26} />
        </div>
        <h3 className="font-display text-3xl text-ink mt-5">
          Request received
        </h3>
        <p className="mt-3 text-ink/60 leading-relaxed max-w-md mx-auto">
          Thank you, {form.name.split(" ")[0] || "traveller"} — we&apos;ll reply
          to <span className="text-ink">{form.email}</span> within a few hours
          with a personal quote. A confirmation email is on its way.
        </p>
        <button
          onClick={openWhatsApp}
          className="mt-7 inline-flex items-center gap-2.5 bg-[#25D366] text-white px-7 py-3.5 text-[13px] uppercase tracking-[0.16em] hover:brightness-105"
        >
          <MessageCircle size={16} /> Chat with us now on WhatsApp
        </button>
      </motion.div>
    );
  }

  return (
    <form onSubmit={submit} className="space-y-5">
      <div className="grid gap-5 sm:grid-cols-2">
        <div>
          <label className="eyebrow text-ink/50 block mb-2" htmlFor="bf-name">
            Your name
          </label>
          <input
            id="bf-name"
            required
            className={inputCls}
            placeholder="Jane Traveller"
            value={form.name}
            onChange={set("name")}
          />
        </div>
        <div>
          <label className="eyebrow text-ink/50 block mb-2" htmlFor="bf-email">
            Email
          </label>
          <input
            id="bf-email"
            type="email"
            required
            className={inputCls}
            placeholder="you@email.com"
            value={form.email}
            onChange={set("email")}
          />
        </div>
      </div>

      <div className="grid gap-5 sm:grid-cols-2">
        <div>
          <label className="eyebrow text-ink/50 block mb-2" htmlFor="bf-phone">
            Phone / WhatsApp <span className="normal-case tracking-normal">(optional)</span>
          </label>
          <input
            id="bf-phone"
            className={inputCls}
            placeholder="+44 …"
            value={form.phone}
            onChange={set("phone")}
          />
        </div>
        <div>
          <label className="eyebrow text-ink/50 block mb-2" htmlFor="bf-service">
            {kind === "booking" ? "Service" : "Topic"}
          </label>
          <select
            id="bf-service"
            required
            className={inputCls}
            value={form.service}
            onChange={set("service")}
          >
            <option value="" disabled>
              Select…
            </option>
            {serviceOptions.map((s) => (
              <option key={s} value={s}>
                {s}
              </option>
            ))}
          </select>
        </div>
      </div>

      {kind === "booking" && (
        <div className="grid gap-5 sm:grid-cols-2">
          <div>
            <label className="eyebrow text-ink/50 block mb-2" htmlFor="bf-date">
              Travel date
            </label>
            <input
              id="bf-date"
              type="date"
              className={inputCls}
              value={form.date}
              onChange={set("date")}
            />
          </div>
          <div>
            <label className="eyebrow text-ink/50 block mb-2" htmlFor="bf-pax">
              Travellers
            </label>
            <select
              id="bf-pax"
              className={inputCls}
              value={form.travellers}
              onChange={set("travellers")}
            >
              {["1", "2", "3", "4", "5", "6", "7", "8+"].map((n) => (
                <option key={n} value={n}>
                  {n}
                </option>
              ))}
            </select>
          </div>
        </div>
      )}

      <div>
        <label className="eyebrow text-ink/50 block mb-2" htmlFor="bf-msg">
          {kind === "booking" ? "Tell us about your trip" : "Your message"}
        </label>
        <textarea
          id="bf-msg"
          rows={5}
          className={inputCls}
          placeholder="Route ideas, hotels, interests, special occasions…"
          value={form.message}
          onChange={set("message")}
        />
      </div>

      <div className="flex flex-col sm:flex-row gap-4 pt-2">
        <motion.button
          whileHover={{ scale: 1.02 }}
          whileTap={{ scale: 0.98 }}
          type="submit"
          disabled={pending}
          className="flex items-center justify-center gap-2.5 bg-ink text-sand px-8 py-4 text-[13px] uppercase tracking-[0.16em] hover:bg-copper transition-colors disabled:opacity-60"
        >
          {pending ? (
            <Loader2 size={17} className="animate-spin" />
          ) : (
            <Send size={16} />
          )}
          {pending ? "Sending…" : "Send request"}
        </motion.button>
        <motion.button
          type="button"
          onClick={openWhatsApp}
          whileHover={{ scale: 1.02 }}
          whileTap={{ scale: 0.98 }}
          className="flex items-center justify-center gap-2.5 bg-[#25D366] text-white px-8 py-4 text-[13px] uppercase tracking-[0.16em] hover:brightness-105"
        >
          <MessageCircle size={17} /> Or send via WhatsApp
        </motion.button>
      </div>

      {state === "wa" && (
        <p className="text-sm text-moss pt-1">
          WhatsApp opened with your enquiry — press send there and we&apos;ll
          reply within hours.
        </p>
      )}
      {state === "error" && (
        <p className="text-sm text-copper pt-1">
          Something went wrong saving your request — please use the WhatsApp
          button instead, or email us directly at{" "}
          <a href={mailto} className="underline">
            {site.email}
          </a>
          .
        </p>
      )}

      <p className="text-xs text-ink/40 pt-1">
        Prefer to talk? WhatsApp or call us anytime on{" "}
        <a href={`tel:${site.phoneE164}`} className="underline hover:text-copper">
          {site.phoneDisplay}
        </a>
        . No payment is taken online — we confirm everything personally first.
      </p>
    </form>
  );
}
